                    <layout class="QGridLayout" name="gridLayout_10">
                     <item row="2" column="0">
                      <widget class="QLabel" name="label_3">
                       <property name="text">
                        <string>Rumble Intensity:</string>
                       </property>
                       <property name="textFormat">
                        <enum>Qt::PlainText</enum>
                       </property>
                       <property name="alignment">
